{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristopherWard13/Weather-Data-Viz/manifest.schema.json",
  "title": "GFS frame manifest (schema 2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "model", "grid", "compression", "layout", "filter", "fields",
    "path_template", "cycle_interval_hours", "display_hours", "latest", "runs"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "generated_at": { "$ref": "#/$defs/isoUtc" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "product"],
      "properties": { "name": { "type": "string" }, "product": { "type": "string" } }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nx", "ny", "lon0", "lat0", "dlon", "dlat", "row_order", "col_order",
        "lat_min", "lat_max", "lon_min", "lon_max"
      ],
      "properties": {
        "nx": { "type": "integer", "minimum": 2 },
        "ny": { "type": "integer", "minimum": 2 },
        "lon0": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat0": { "type": "number", "minimum": -90, "maximum": 90 },
        "dlon": { "type": "number", "exclusiveMinimum": 0 },
        "dlat": { "type": "number", "exclusiveMaximum": 0 },
        "row_order": { "const": "north_to_south" },
        "col_order": { "const": "west_to_east" },
        "lat_min": { "type": "number" },
        "lat_max": { "type": "number" },
        "lon_min": { "type": "number" },
        "lon_max": { "type": "number" }
      }
    },
    "compression": { "const": "gzip" },
    "layout": { "const": "bands_concatenated_row_major_little_endian" },
    "filter": { "const": "row_delta" },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/fieldId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "min_fhr", "frame_bytes", "bands"],
        "properties": {
          "label": { "type": "string" },
          "min_fhr": { "type": "integer", "minimum": 0 },
          "frame_bytes": { "type": "integer", "minimum": 1 },
          "bands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "units", "dtype", "scale", "offset"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "units": { "type": "string" },
                "dtype": { "enum": ["uint8", "uint16"] },
                "scale": { "type": "number", "exclusiveMinimum": 0 },
                "offset": { "type": "number" },
                "wrap": { "type": "number", "exclusiveMinimum": 0 },
                "categories": { "type": "array", "items": { "type": "string" }, "minItems": 2 }
              }
            }
          }
        }
      }
    },
    "path_template": { "type": "string", "pattern": "\\{run\\}.*\\{field\\}.*\\{fhr:03d\\}" },
    "cycle_interval_hours": { "type": "integer", "minimum": 1 },
    "display_hours": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
    "latest": { "oneOf": [{ "$ref": "#/$defs/runId" }, { "type": "null" }] },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "init", "hours", "complete"],
        "properties": {
          "id": { "$ref": "#/$defs/runId" },
          "init": { "$ref": "#/$defs/isoUtc" },
          "hours": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/fieldId" },
            "additionalProperties": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0, "maximum": 999 }
            }
          },
          "complete": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "runId": { "type": "string", "pattern": "^[0-9]{10}$" },
    "fieldId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "isoUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
