{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristopherWard13/Weather-Data-Viz/manifest.schema.json",
  "title": "GFS 250 mb wind speed frame manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "model", "encoding", "grid",
    "path_template", "cycle_interval_hours", "display_hours", "latest", "runs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "$ref": "#/$defs/isoUtc" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "product", "level", "field"],
      "properties": {
        "name": { "type": "string" },
        "product": { "type": "string" },
        "level": { "type": "string" },
        "field": { "type": "string" }
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dtype", "units", "scale", "offset", "valid_min", "valid_max",
        "rounding", "compression", "layout", "frame_bytes"
      ],
      "properties": {
        "dtype": { "const": "uint8" },
        "units": { "const": "kt" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "offset": { "type": "number" },
        "valid_min": { "const": 0 },
        "valid_max": { "const": 255 },
        "rounding": { "const": "nearest" },
        "compression": { "const": "gzip" },
        "layout": { "const": "row_major" },
        "frame_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nx", "ny", "lon0", "lat0", "dlon", "dlat", "row_order", "col_order",
        "lat_min", "lat_max", "lon_min", "lon_max"
      ],
      "properties": {
        "nx": { "type": "integer", "minimum": 2 },
        "ny": { "type": "integer", "minimum": 2 },
        "lon0": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat0": { "type": "number", "minimum": -90, "maximum": 90 },
        "dlon": { "type": "number", "exclusiveMinimum": 0 },
        "dlat": { "type": "number", "exclusiveMaximum": 0 },
        "row_order": { "const": "north_to_south" },
        "col_order": { "const": "west_to_east" },
        "lat_min": { "type": "number" },
        "lat_max": { "type": "number" },
        "lon_min": { "type": "number" },
        "lon_max": { "type": "number" }
      }
    },
    "path_template": { "type": "string", "pattern": "\\{run\\}.*\\{fhr:03d\\}" },
    "cycle_interval_hours": { "type": "integer", "minimum": 1 },
    "display_hours": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "latest": { "oneOf": [{ "$ref": "#/$defs/runId" }, { "type": "null" }] },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "init", "hours", "complete"],
        "properties": {
          "id": { "$ref": "#/$defs/runId" },
          "init": { "$ref": "#/$defs/isoUtc" },
          "hours": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 0, "maximum": 999 }
          },
          "complete": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "runId": { "type": "string", "pattern": "^[0-9]{10}$" },
    "isoUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
