{
  "projection": {
    "central_meridian": -110,
    "parallels": [30, 60]
  },
  "views": {
    "jet": {
      "isotachs_kt": { "min": 50, "max": 190, "step": 10, "default": [100] },
      "trend_limit": 60,
      "auto_round": 10
    },
    "t2m": { "trend_limit": 20, "auto_round": 5 },
    "wind10": { "trend_limit": 20, "auto_round": 5 },
    "precip": { "trend_limit": 0.5, "auto_round": 0.25 },
    "precip:24h": { "trend_limit": 1, "auto_round": 0.25 },
    "precip:total": { "trend_limit": 2, "auto_round": 0.5 },
    "snow:6h": { "trend_limit": 4, "auto_round": 1 },
    "snow:24h": { "trend_limit": 8, "auto_round": 2 },
    "snow:total": { "trend_limit": 12, "auto_round": 2 },
    "h500": { "trend_limit": 60, "auto_round": 10 },
    "t850": { "trend_limit": 8, "auto_round": 2 }
  },
  "model_bar": [
    { "group": "Global", "products": ["gfs", "ecmwf", "gdps", "icon"] },
    { "group": "AI", "products": ["aifs", "aigfs"] },
    { "group": "Ensemble mean", "products": ["gefs", "ecmwf-ens", "aigefs", "hgefs"] }
  ],
  "pipeline": {
    "lookback_cycles": 8,
    "workers": 6,
    "retries": 3
  }
}
