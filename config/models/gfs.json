{
  "name": "GFS",
  "credit": "NOAA",
  "snowfall": "GFS has no snowfall field, so this is derived from its own output: the 6-hour average snow flag (the share of the 6 hours it was snowing) times its 6-hour precipitation. The flag isn't weighted by amount, so heavy rain and then light snow counts some of the rain as snow.",
  "source": {
    "adapter": "herbie",
    "herbie_model": "gfs",
    "herbie_product": "pgrb2.0p25",
    "priority": "aws",
    "index_url": "https://noaa-gfs-bdp-pds.s3.amazonaws.com/gfs.{init:%Y%m%d}/{init:%H}/atmos/gfs.t{init:%H}z.pgrb2.0p25.f{fhr:03d}.idx"
  },
  "cycle_interval_hours": 6,
  "latency_minutes": 331,
  "forecast_hours": {
    "min": 0,
    "max": 384,
    "step": 6,
    "model_max": 384
  },
  "lags_hours": [6, 12, 24, 48],
  "default_lag_hours": 48,
  "fields": {
    "wspd250": { "search": ":(?:UGRD|VGRD):250 mb:" },
    "wdir250": { "search": ":(?:UGRD|VGRD):250 mb:" },
    "t2m": { "search": ":TMP:2 m above ground:" },
    "d2m": { "search": ":DPT:2 m above ground:" },
    "wspd10": { "search": ":(?:UGRD|VGRD):10 m above ground:" },
    "wdir10": { "search": ":(?:UGRD|VGRD):10 m above ground:" },
    "gust": { "search": ":GUST:surface:" },
    "mslp": { "search": ":MSLET:mean sea level:" },
    "precip": {
      "search": ":APCP:surface:{a}-{f} hour acc|:(?:CRAIN|CSNOW|CICEP|CFRZR):surface:{a}-{f} hour ave",
      "min_fhr": 6
    },
    "snow": {
      "search": ":APCP:surface:{a}-{f} hour acc|:CSNOW:surface:{a}-{f} hour ave",
      "min_fhr": 6
    },
    "hgt500": { "search": ":HGT:500 mb:" },
    "vort500": { "search": ":(?:UGRD|VGRD):500 mb:" },
    "t850": { "search": ":TMP:850 mb:" }
  },
  "products": {
    "gfs": { "grid": "na025" }
  }
}
